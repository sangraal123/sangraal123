---
import '../styles/site.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
	title: string;
	description: string;
	/** <title> をそのまま使う（トップページなど） */
	bare?: boolean;
}

const { title, description, bare = false } = Astro.props;
const pageTitle = bare ? title : `${title} | googja.dev`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://googja.dev').href;
const ogImage = new URL('/Icon-512.png', Astro.site ?? 'https://googja.dev').href;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/Icon-512.png" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="googja.dev" />
		<meta property="og:locale" content="ja_JP" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&display=swap"
		/>

		{/* Starlight と同じ localStorage キー・同じ data-theme を使い、
		    ポートフォリオ ⇄ ガイド間で明暗設定を引き継ぐ。描画前に当てて FOUC を防ぐ。 */}
		<script is:inline>
			(() => {
				const stored = typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme');
				const theme =
					stored === 'light' || stored === 'dark'
						? stored
						: matchMedia('(prefers-color-scheme: light)').matches
							? 'light'
							: 'dark';
				document.documentElement.dataset.theme = theme;
				// [data-reveal] の初期状態を伏せてよいかの目印。JS が無ければ何も隠さない。
				document.documentElement.classList.add('has-js');
			})();
		</script>

		<script
			async
			src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7543104245383277"
			crossorigin="anonymous"></script>
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-5ZWD1BZHLD"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag('js', new Date());
			gtag('config', 'G-5ZWD1BZHLD');
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main">本文へスキップ</a>
		<SiteHeader />
		<main id="main">
			<slot />
		</main>
		<SiteFooter />

		<script>
			// 節が視界に入ったら現れる。要素ごとに少し遅らせて、上から順に立ち上がるようにする。
			const targets = document.querySelectorAll('[data-reveal]');
			if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && targets.length) {
				const io = new IntersectionObserver(
					(entries) => {
						for (const e of entries) {
							if (!e.isIntersecting) continue;
							e.target.classList.add('is-in');
							io.unobserve(e.target);
						}
					},
					{ rootMargin: '0px 0px -12% 0px', threshold: 0.08 }
				);
				for (const el of targets) io.observe(el);
			} else {
				for (const el of targets) el.classList.add('is-in');
			}
		</script>
	</body>
</html>
