---
import Base from '../../layouts/Base.astro';
import WorkList from '../../components/WorkList.astro';
import { works } from '../../data/site';

const products = works.filter((w) => w.group === 'product');
const collabs = works.filter((w) => w.group === 'collab');
---

<Base
	title="Works"
	description="sangraalが開発・参加しているプロダクト、ガイド、オープンソース活動の一覧。"
>
	<section class="shell pagehead">
		<p class="label"><b>Works</b> — Products, writing, collaborations</p>
		<h1>作ったものと、<br />関わっているもの。</h1>
		<p class="lead">
			公開・開発中の個人プロダクト、開発知見を公開しているガイド、チームやコミュニティでの取り組みを、担当した範囲が分かる形で並べています。
		</p>
	</section>

	<div class="band">
		<div class="shell section">
			<p class="label" data-reveal><b>01</b> Products</p>
			<div class="section__body" data-reveal style="--reveal-delay:.09s">
				<WorkList items={products} />
				<ul class="notes" style="margin-top: 2.5rem">
					<li data-no="—">
						<span
							><b>無限脳</b>：iOS・Androidで公開中の脳トレゲーム。7つのコロニーの基地開拓、FlameによるRTS遠征、復習帳を備え、1.1.2ではInfinity・複合アノマリーのランキングと浮遊する相棒を追加し、画像を軽量化しました。企画、UI・ゲーム実装、問題データ、保存とバックアップ、Firebase連携、分析、広告と課金、CI/CDまで担当しています。ブラウザ版の公開は終了し、旧URLはアプリ紹介ページに変更しました。</span
						>
					</li>
					<li data-no="—">
						<span><b>漢字脳</b>：和同開珎・四字熟語・手がかり想起の3つの遊びを、1日3問から楽しむ漢字パズル。ExpoによるiOS・Androidアプリ、問題データ、語彙帳、日々の記録と紹介サイトを開発しています。アプリは公開準備中で、LPでは和同開珎を試せます。</span>
					</li>
					<li data-no="—">
						<span
							><b>VibeCode Mobile</b>：AIとExpoでアプリを作る工程を、準備・リサーチ・リデザイン・コーディング・フィードバック・公開＆マネタイズ・応用・セキュリティの8フェーズ・40記事に分けて執筆。サイトの設計と実装も自分で行っています。</span
						>
					</li>
				</ul>
			</div>
		</div>
	</div>

	<div class="band">
		<div class="shell section">
			<p class="label" data-reveal><b>02</b> Team &amp; Open source</p>
			<div class="section__body" data-reveal style="--reveal-delay:.09s">
				<WorkList items={collabs} />
				<ul class="notes" style="margin-top: 2.5rem">
					<li data-no="—">
						<span
							><b>HENKAKU Initiation</b>：ウォレット準備からInitiation、チェックイン、申請までを案内するNext.jsアプリの検証・開発に参加。</span
						>
					</li>
					<li data-no="—">
						<span
							><b>ぼどぷる</b>：ボードゲームのプレイ履歴をNFTとして残すチームプロジェクト。2024年度に始まったVer.1を引き継ぎ、Expoアプリ、証明と名刺のコントラクト、Cloudflare
							WorkersのAPI、配信までをVer.2として担当しています。</span
						>
					</li>
				</ul>
			</div>
		</div>
	</div>

	<div class="band">
		<div class="shell section">
			<p class="label" data-reveal><b>03</b> Elsewhere</p>
			<div class="section__body" data-reveal style="--reveal-delay:.09s">
				<ul class="links">
					<li>
						<a href="https://github.com/sangraal123?tab=repositories" rel="noopener">
							<b>GitHub Repositories ↗</b>
							<span>試作、学習成果、過去プロジェクトを含む公開リポジトリの一覧。</span>
						</a>
					</li>
					<li>
						<a href="https://braininfinity.googja.dev/" rel="noopener">
							<b>無限脳 アプリ紹介 ↗</b>
							<span>遊び方とストアへの案内。ブラウザ版の公開は終了しました。</span>
						</a>
					</li>
					<li>
						<a href="https://kanjinou.googja.dev/" rel="noopener">
							<b>漢字脳 アプリ紹介 ↗</b>
							<span>開発中の漢字パズル。和同開珎のお試しも公開中。</span>
						</a>
					</li>
					<li>
						<a href="https://apps.apple.com/jp/app/id6755319401" rel="noopener">
							<b>App Store ↗</b>
							<span>iPhone・iPad版の無限脳。</span>
						</a>
					</li>
					<li>
						<a
							href="https://play.google.com/store/apps/details?id=com.sangraal.androidfirst&hl=ja"
							rel="noopener"
						>
							<b>Google Play ↗</b>
							<span>Android版の無限脳。</span>
						</a>
					</li>
				</ul>
			</div>
		</div>
	</div>
</Base>
