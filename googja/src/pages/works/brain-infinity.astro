---
import Base from '../../layouts/Base.astro';
import { shots, brainInfinity } from '../../data/site';

const sections = [
	{
		no: '03', label: 'Training & Review',
		title: '毎回の10問を、回答履歴から組み立てる。',
		lead: '数学・論理・記憶・注意・言語の5カテゴリに、各6レベル。日本語と英語にそれぞれ3,000問を用意し、苦手な種類の復習と新しい挑戦を、一つのセッションに組み込みます。',
		rows: [
			['Adaptive', '1回10問を基準7問・復習2問・挑戦1問で構成。カテゴリ・レベル・グループごとの正答率を使い、復習の2問を苦手なグループから先に確保します。直近30問の重複を避け、10のグループへ出題を散らします。'],
			['Levels', '正答率60%で銅、80%で銀、100%で金メダル。銀メダルで次のレベルを解放します。1問30秒で、同じレベル内でも取り組みやすい問題から進みます。ヒントは考える手がかり、解説は答えの理由を示します。'],
			['Review', '通常問題・推理チャレンジ・アクションラボ・Infinity・複合アノマリーの誤答と時間切れを、直近200問まで記録。分野で絞り込み、「要復習」から1回最大10問を解き直せます。アクションラボは元の問題を操作して再挑戦できます。'],
			['Rewards', '復習を最後まで終えると、回答数に応じて通常の2倍のルミナとコアXPを獲得します。「復習済み」は内容の閲覧用に残し、再練習と報酬の繰り返し獲得はできません。通常問題の成績やレベル解放とは別に記録します。'],
			['Storage', '出題調整にはグループごとの挑戦回数と正解数を保存。生成問題や操作パズルは出題内容も残し、同じ問題を解き直せるようにしています。結果直後の回答レビューと、後日の復習を用意しています。'],
			['Feedback', '気になる通常問題は1プレイ2回まで、理由を選んで報告し、別の問題へ進めます。通信できないときは端末に保存し、起動・復帰などで再送。「送信済み」と「端末に保存」を区別し、利用状況データの共有設定とは独立して扱います。'],
		],
	},
	{
		no: '04', label: 'Neural Frontier',
		title: '脳トレの積み重ねが、基地の姿になる。',
		lead: '脳トレで得たルミナとブレインコアの成長を、建設・増築・遠征へつなげます。1.1.4では全7コロニーの施設外観と室内表示を刷新。部屋を開いて、設備やクルーの暮らしを見られるように整えました。',
		rows: [
			['Colonies', 'ORIGINからHORIZONまで7つのコロニー。それぞれ6施設、内部に36区画を持ち、施設はLv.10まで成長します。建設にはルミナを使い、開放にはコアレベルが必要。中央司令塔には、育てたブレインコアの姿が映ります。'],
			['Restoration', '施設を開いたときの拡大表示・移動・全体表示への切り替えを改善。次の開拓目標を旗や枠で示し、復旧時の光と、クルー・ロボットが到着して働き始める演出を整えました。全設備を復旧すると次のコロニーへ進み、基地日誌も開きます。'],
			['RTS', 'Flameによるリアルタイムの拠点奪還戦。前衛・射撃・工兵の3部隊に進軍と守備を指示し、東西のジェネレーターを揚陸拠点につないで中枢の防壁を開きます。4分以内に中枢を奪還すると、目標の区画が復旧します。'],
			['Balance', '電力で守備ドローンを配置し、部隊を回復できます。難度は区画ごとに固定し、施設の増築では味方を強くします。遠征でルミナやコアXPは増えず、脳トレで補給して開拓する循環を保ちます。'],
		],
	},
	{
		no: '05', label: 'Challenge & Ranking',
		title: '手を動かすパズルと、記録への挑戦。',
		lead: '15形式・900問の推理チャレンジ、10形式の操作パズル、続けられるだけ挑む2つのモードを用意。1.1.4では推理の重複出題を抑え、説明から答え合わせまでの流れを改善しています。',
		rows: [
			['Reasoning', '規則・空間・条件・言葉・数量の5カテゴリに、図形行列・展開図・言葉の類推など15形式の4択問題を900問収録。1回10問、3段階の難度で5・7・9問以上の正解を目指し、1問45〜120秒で挑戦します。中断後も続きから再開できます。'],
			['Explanation', '形式ごとの遊び方と難度を説明し、一部の問題には図解を追加。同じ挑戦で見た目や内容が同じ問題を繰り返さないようにしています。回答後は正誤と解説を表示して自動で次問へ進み、間違い・時間切れでは表示時間を長く取ります。'],
			['Action Lab', '5カテゴリに各2形式、全10形式。つなぎ算、数の天秤、光った順のタップ、図形の配置、動く対象の探索などを、同じ形式の10問で遊びます。制限時間はなく、新規挑戦も再開も無料です。'],
			['Difficulty', '形式ごとに「やさしい・標準・難しい」を選び、途中経過とベスト記録を形式・難度ごとに保存。各形式のイラストと、タップ・配置への反応で遊び方を伝えます。'],
			['Infinity', '5カテゴリを次々に出題し、誤答と時間切れの合計3回で終了。連続正解と速い回答でスコアが伸びます。'],
			['Anomaly', '複合アノマリーは持ち時間45秒から開始。正解で時間が増え、誤答で減る中で、実際に回答していた生存時間を記録します。Infinityとともに、通常トレーニングのメダル・レベル解放とは別の記録です。'],
			['Ranking', 'iOS・Android版では、Infinityの得点と複合アノマリーの生存時間をランキングで比較。今週・先週・全期間の上位100人と自分の順位を表示し、週間は毎週月曜0時の日本時間で切り替えます。'],
			['Participation', '初期状態で自動参加し、設定の名前と参加中に始めた新しいプレイの記録を公開します。「ランキングに参加しない」をオンにすると新規送信を止め、送信待ちも消去。以前の停止設定は引き継ぎ、公開済みの記録は残ります。復元した記録や既存の自己ベストは投稿しません。'],
		],
	},
	{
		no: '06', label: 'Progress & Companion',
		title: '続けたことを、次の一歩へつなぐ。',
		lead: '毎日の目標、成長の記録、相棒の声かけを組み合わせ、出題画面以外にも戻ってきたくなる場所を作っています。',
		rows: [
			['Missions', '通常問題・推理チャレンジ・アクションラボから毎日1つずつ、成績に合わせてメインミッションを提案。後の2つは指定難度でのクリアが条件です。3つ達成した日はカレンダーにマークがつき、遠征はメインミッションの対象から外しています。'],
			['Lab', '研究ラボでブレインコア、回答履歴から算出するゲーム内の成長指標NEURAL INDEX、成長軌道、5分野のニューラル・スペクトラムを表示。同じカテゴリ・レベルの直近5プレイの平均正答率と、今の成績に合ったおすすめも確認できます。'],
			['Calendar', 'メダル獲得、問題セットをまたぐ連続正解、連続ミッション、チェックイン、プレイ日数を記録。カレンダーの下には、全30レベルのメダルを見渡せるマスターボードを置いています。毎日の通知は時刻変更と停止ができます。'],
			['Companion', 'ホームと結果画面では、脳の姿をした相棒が声をかけます。タップするたびに別の言葉を表示し、ドラッグで移動。動きの軽減や高コントラストの設定では、静止した姿で表示します。ブレインコアの見た目も調整しました。'],
			['Feed', '「みんなのフィード」で自己ベスト更新、連続トレーニングの節目、メインミッション達成を共有し、「お祝い」を送れます。公開は初期状態で有効で、設定から新しい公開を停止できます。公開済みの投稿は残り、ランキング・分析とは別に管理します。'],
			['Cloud save', '進行は端末内に保存し、任意のGoogle・Apple連携で名前・生年とともにクラウド保存・復元できます。両方に変更がある場合は使用するデータを選び、経験値やアイテムは合算しません。ファイル式バックアップを置き換え、連携なしでもプレイできます。'],
		],
	},
	{
		no: '07', label: 'Monetization & Measurement',
		title: '遊ぶ流れを保ちながら、運営する。',
		lead: '通常問題の全30レベルと操作パズルは無料で遊べます。モバイル版は広告と広告除去の買い切りで運営し、プレイから基地開拓までの流れを計測して、公開後の改善につなげています。',
		rows: [
			['Ads', 'バナーは研究ラボのスクロール末尾に配置。全画面広告は、通常問題・推理チャレンジ・アクションラボ・Infinity・複合アノマリーの完了回数を共有し、5回ごとに最大1回、記録保存後・結果表示前に出します。回答中には表示しません。'],
			['Purchase', '「広告を非表示」は期限も自動更新もない非消費型アイテムで、バナーと全画面広告を除去します。同じストアのアカウントで購入を復元でき、購入なしでもすべての問題を遊べます。'],
			['Analytics', 'モバイルのFirebase Analyticsで、トレーニング、復習、報酬、基地開拓、RTS遠征、広告・購入のイベントを定義。計測仕様とBigQueryの集計を合わせて管理し、遠征の完了・中断と未確定の記録も区別します。'],
			['Consent', '年齢確認と利用状況データの共有設定に応じて分析を開始し、設定から停止できます。ランキング、達成フィード、問題報告は、分析用データの共有とは独立して扱います。'],
		],
	},
];

const stack = [
	['App / Game', 'Flutter、Material 3、GoRouter、Flame'],
	['State / Local', 'Provider、Flutter Bloc、SharedPreferences、JSON問題集・復習用の出題保存'],
	['Online', 'Firebase Authentication（匿名・Google・Apple）、Cloud Firestore（ランキング・達成フィード・クラウド保存・問題報告）'],
	['Performance', '画像スプライトの共有、Isolateによる問題読み込みの分離'],
	['Analytics', 'Firebase Analytics、BigQuery'],
	['Ads / Purchases', 'Google Mobile Ads、in_app_purchase、StoreKit、Google Play Billing'],
	['Quality', 'flutter_test、Mockito、レスポンシブ回帰テスト、実画面の自動撮影'],
	['Delivery', 'GitHub Actions、Fastlane、App Store Connect、Google Play Console'],
];
---

<Base
	title="無限脳"
	description="無限脳1.1.4の開発事例。全7コロニーの表示刷新、900問の推理チャレンジ、分野別に復習できる復習帳、達成フィード、Google・Apple連携によるクラウド保存を紹介します。iOS・Android向けの脳トレゲームです。"
>
	<section class="shell pagehead">
		<p class="label"><b>Case study</b> — Product</p>
		<div class="feature" style="margin-top: 1.25rem">
			<div>
				<h1>無限脳</h1>
				<p class="lead">脳を鍛えて、宇宙の基地を育てる。</p>
				<p class="lead">
					数学・論理・記憶・注意・言語のクイズ、900問の推理チャレンジ、操作パズル。その積み重ねが、7つのコロニーの建設・復旧と、リアルタイムの拠点奪還戦につながるトレーニングゲームです。
				</p>
				<p class="lead">
					1.1.4では全コロニーの外観・室内表示を刷新し、推理の説明と自動進行、復習帳の分野別絞り込み、読み込み処理を改善しました。ランキング、達成フィード、任意のアカウント連携とクラウド保存も備えています。
				</p>
				<ul class="tags" style="margin-top: 2rem">
					<li>Version {brainInfinity.version}</li><li>Flutter / Flame</li><li>iOS</li><li>Android</li>
					<li>日本語 / English（Brain Infinity）</li>
				</ul>
				<div class="actions">
					<a class="btn" href="https://braininfinity.googja.dev/" rel="noopener">アプリ紹介・ダウンロード先へ<span aria-hidden="true">↗</span></a>
					<a class="ulink" href="/works/">Worksへ戻る<span aria-hidden="true">→</span></a>
				</div>
			</div>
			<figure class="plate">
				<img src="/Icon-512.png" width="512" height="512" alt="無限脳のアプリアイコン" />
				<figcaption><span>無限脳</span><span>App icon</span></figcaption>
			</figure>
		</div>
	</section>

	<div class="band" id="screens">
		<div class="shell section">
			<p class="label" data-reveal><b>01</b> Screens</p>
			<div class="section__body" data-reveal style="--reveal-delay:.09s">
				<h2 class="h2">{brainInfinity.version}の無限脳を、{shots.length}の画面で。</h2>
				<p class="lead" style="margin-top: 1.5rem">
					{brainInfinity.screenshotsCapturedJa}に{brainInfinity.version}のアプリ本体から撮影した日本語の実画面です。進行・成績・フィード・アカウントには撮影用のサンプルデータを使っています。配信状況は各ストアでご確認いただけます。
				</p>
				<p class="label" style="margin-top: 1rem">Screens captured — <time datetime={brainInfinity.screenshotsCaptured}>{brainInfinity.screenshotsCaptured.replaceAll('-', '.')}</time></p>
				<ul class="screens">
					{shots.map((s) => (
						<li><figure>
							<img src={s.src} width={s.width} height={s.height} alt={s.alt} loading="lazy" decoding="async" />
							<figcaption><span>{s.no}</span>{s.caption}</figcaption>
						</figure></li>
					))}
				</ul>
			</div>
		</div>
	</div>

	<div class="band">
		<div class="shell section">
			<p class="label" data-reveal><b>02</b> Scope</p>
			<div class="section__body" data-reveal style="--reveal-delay:.09s">
				<h2 class="h2">企画から、ゲーム開発と公開後の運営まで。</h2>
				<p class="lead" style="margin-top: 1.5rem">
					問題データと出題ロジック、FlutterのUI、Flameの戦闘、進行の保存、Firebaseのランキング・フィード・アカウント連携、分析と収益化、CI/CD、ストア公開を一貫して担当しています。
				</p>
				<ul class="notes" style="margin-top: 2.5rem">
					<li data-no="01"><span><b>学習とゲーム進行をつなぐ。</b>回答の報酬をコアの成長と基地開拓へ結び、結果から次の施設へ進める流れを設計しています。</span></li>
					<li data-no="02"><span><b>複数の端末と遊び方に対応する。</b>スマートフォンとタブレットの幅や向きに合わせて配置を切り替え、iPadでも画面下部から主要4画面を移動できます。文字拡大、高コントラスト、動きの軽減、効果音の字幕も用意しています。</span></li>
					<li data-no="03"><span><b>読み込みと表示を改善する。</b>画像スプライトを共有し、問題の読み込みをIsolateへ分離。施設の拡大・移動、戻る操作、日英の説明と表示も見直しました。</span></li>
				</ul>
			</div>
		</div>
	</div>

	{sections.map((section) => (
		<div class="band">
			<div class="shell section">
				<p class="label" data-reveal><b>{section.no}</b> {section.label}</p>
				<div class="section__body" data-reveal style="--reveal-delay:.09s">
					<h2 class="h2">{section.title}</h2>
					<p class="lead" style="margin-top: 1.5rem">{section.lead}</p>
					<table class="table" style="margin-top: 2.5rem"><tbody>
						{section.rows.map(([label, text]) => <tr><th scope="row">{label}</th><td>{text}</td></tr>)}
					</tbody></table>
				</div>
			</div>
		</div>
	))}

	<div class="band">
		<div class="shell section">
			<p class="label" data-reveal><b>08</b> Stack &amp; Principles</p>
			<div class="section__body" data-reveal style="--reveal-delay:.09s">
				<h2 class="h2">一つの実装を、配信と運営まで育てる。</h2>
				<table class="table" style="margin-top: 2.5rem"><tbody>
					{stack.map(([label, text]) => <tr><th scope="row">{label}</th><td>{text}</td></tr>)}
				</tbody></table>
				<ul class="notes" style="margin-top: 2.5rem">
					<li data-no="01"><span><b>出題の判断をテストできる形にする。</b>10問の組み立ては問題集・成績・直近の履歴を受け取る処理に分け、乱数を固定して苦手なグループの優先や重複回避を検証します。</span></li>
					<li data-no="02"><span><b>進行とオンラインの状態を分ける。</b>端末内の記録保存を先に完了し、ランキングとフィードは公開中の新しい記録・達成だけを送信。クラウド保存が競合した場合は使用するデータを選び、復元した過去の記録を新しい達成として投稿しません。</span></li>
					<li data-no="03"><span><b>画面と掲載素材を同じ実装から出す。</b>アプリのウィジェットを、日本語・英語とストア指定の端末サイズで撮影。UIの変更を実画面で確認し、掲載画像もその撮影結果から更新します。</span></li>
				</ul>
			</div>
		</div>
	</div>

	<div class="band">
		<div class="shell section">
			<p class="label" data-reveal><b>09</b> Where to play</p>
			<div class="section__body" data-reveal style="--reveal-delay:.09s">
				<h2 class="h2">公開先</h2>
				<p class="lead" style="margin-top: 1.5rem">ブラウザ版の公開は終了しました。旧URLはアプリ紹介ページに切り替え、iOS・Androidのダウンロード先をご案内しています。</p>
				<ul class="links" style="margin-top: 2.5rem">
					<li><a href="https://braininfinity.googja.dev/" rel="noopener"><b>アプリ紹介サイト ↗</b><span>遊び方、よくある質問、ストアへの案内を掲載しています。</span></a></li>
					<li><a href="https://apps.apple.com/jp/app/id6755319401" rel="noopener"><b>App Store ↗</b><span>iPhone・iPad版。ランキングにも参加できます。</span></a></li>
					<li><a href="https://play.google.com/store/apps/details?id=com.sangraal.androidfirst&hl=ja" rel="noopener"><b>Google Play ↗</b><span>Android版。ランキングにも参加できます。</span></a></li>
				</ul>
			</div>
		</div>
	</div>
</Base>
