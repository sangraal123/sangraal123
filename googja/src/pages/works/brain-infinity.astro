---
import Base from '../../layouts/Base.astro';
import { shots } from '../../data/site';

const sections = [
	{
		no: '03', label: 'Training & Review',
		title: '毎回の10問を、回答履歴から組み立てる。',
		lead: '数学・論理・記憶・注意・言語の5カテゴリに、各6レベル。日本語と英語にそれぞれ3,000問を用意し、苦手な種類の復習と新しい挑戦を、一つのセッションに組み込みます。',
		rows: [
			['Adaptive', '1回10問を基準7問・復習2問・挑戦1問で構成。カテゴリ・レベル・グループごとの正答率を使い、復習の2問を苦手なグループから先に確保します。直近30問の重複を避け、10のグループへ出題を散らします。'],
			['Levels', '正答率60%で銅、80%で銀、100%で金メダル。銀メダルで次のレベルを解放します。1問30秒で、問題の報告と差し替えは1セッション2回まで。表示済みの問題の時間は、アプリを離れている間も進みます。'],
			['Review', '結果画面ではその回の問題・自分の回答・正答を読み返せます。通常問題の誤答と時間切れは復習帳にも最大200問残し、あとから1回最大10問を解き直せます。完了時のルミナとコアXPは通常の2倍で、通常問題の成績やレベル解放とは別に記録します。'],
			['Storage', '出題調整にはグループごとの挑戦回数と正解数を保存。復習帳には問題ID・改訂番号・誤答回数などを残し、問題本文はアプリ内の問題集から読み込みます。結果直後の回答レビューと、後日の復習を分けて扱います。'],
		],
	},
	{
		no: '04', label: 'Neural Frontier',
		title: '脳トレの積み重ねが、基地の姿になる。',
		lead: '通常問題と操作パズルで得たルミナとブレインコアの成長を、建設・増築・遠征へつなげます。結果画面にも現在の開拓目標と不足条件を表示し、今日のプレイが次の設備にどうつながるかを見せています。',
		rows: [
			['Colonies', 'ORIGINからHORIZONまで7つのコロニー。それぞれ6施設、内部に36区画を持ち、施設はLv.10まで成長します。建設にはルミナを使い、開放にはコアレベルが必要。中央司令塔には、育てたブレインコアの姿が映ります。'],
			['Restoration', '施設の外観と内部を同じ画面で見せ、区画を復旧すると設備が戻り、クルーとロボットが働き始めます。全設備の復旧で次のコロニーへ進み、基地日誌も開いていきます。吹き出しの操作ガイドと無料の遠征練習場を用意しています。'],
			['RTS', 'Flameによるリアルタイムの拠点奪還戦。前衛・射撃・工兵の3部隊に進軍と守備を指示し、東西のジェネレーターを揚陸拠点につないで中枢の防壁を開きます。4分以内に中枢を奪還すると、目標の区画が復旧します。'],
			['Balance', '電力で守備ドローンを配置し、部隊を回復できます。難度は区画ごとに固定し、施設の増築では味方を強くします。遠征でルミナやコアXPは増えず、脳トレで補給して開拓する循環を保ちます。'],
		],
	},
	{
		no: '05', label: 'Challenge & Ranking',
		title: '手を動かすパズルと、記録への挑戦。',
		lead: '短い10問を解く遊びに加え、タップや配置で考えるアクションラボと、続けられるだけ挑む2つのモードを実装しています。',
		rows: [
			['Action Lab', '5カテゴリに各2形式、全10形式。つなぎ算、数の天秤、光った順のタップ、図形の配置、動く対象の探索などを、同じ形式の10問で遊びます。制限時間はなく、新規挑戦も再開も無料です。'],
			['Difficulty', '形式ごとに「やさしい・標準・難しい」を選び、途中経過とベスト記録を形式・難度ごとに保存。各形式のイラストと、タップ・配置への反応で遊び方を伝えます。'],
			['Infinity', '5カテゴリを次々に出題し、誤答と時間切れの合計3回で終了。連続正解と速い回答でスコアが伸びます。'],
			['Anomaly', '複合アノマリーは持ち時間45秒から開始。正解で時間が増え、誤答で減る中で、実際に回答していた生存時間を記録します。Infinityとともに、通常トレーニングのメダル・レベル解放とは別の記録です。'],
			['Ranking', 'iOS・Android版では、Infinityの得点と複合アノマリーの生存時間をランキングで比較。今週・先週・全期間の上位100人と自分の順位を表示し、週間は毎週月曜0時の日本時間で切り替えます。'],
			['Participation', '参加は任意で、選んだ表示名と参加後に始めたプレイの記録を公開します。Firebase匿名認証とFirestoreで管理し、通信失敗時は保存した送信待ち記録を再送。既存の自己ベストやバックアップから復元した記録は投稿しません。'],
		],
	},
	{
		no: '06', label: 'Progress & Companion',
		title: '続けたことを、次の一歩へつなぐ。',
		lead: '毎日の目標、成長の記録、相棒の声かけを組み合わせ、出題画面以外にも戻ってきたくなる場所を作っています。',
		rows: [
			['Missions', '通常問題・チャレンジ問題・遠征から毎日1つずつ、選定理由と達成条件を添えて提案。遠征は施設の内部区画が開いてから届きます。3つ達成した日は、プレイカレンダーにメインストリークのマークがつきます。'],
			['Lab', '研究ラボでブレインコア、回答履歴から算出するゲーム内の成長指標NEURAL INDEX、成長軌道、5分野のニューラル・スペクトラムを表示。同じカテゴリ・レベルの直近5プレイの平均正答率と、今の成績に合ったおすすめも確認できます。'],
			['Calendar', 'メダル獲得、問題セットをまたぐ連続正解、連続ミッション、チェックイン、プレイ日数を記録。カレンダーの下には、全30レベルのメダルを見渡せるマスターボードを置いています。毎日の通知は時刻変更と停止ができます。'],
			['Companion', 'ホームと結果画面では、脳の姿をした相棒が声をかけます。タップでメッセージを再表示し、ドラッグで移動。動きの軽減や高コントラストの設定では、静止した姿で表示します。'],
			['Backup', '進行は端末内へ保存し、設定からファイルにバックアップ・復元できます。匿名認証のIDや認証情報はバックアップに含めず、進行の復元とオンライン参加者の識別を分けています。'],
		],
	},
	{
		no: '07', label: 'Monetization & Measurement',
		title: '遊ぶ流れを保ちながら、運営する。',
		lead: '通常問題の全30レベルと操作パズルは無料で遊べます。モバイル版は広告と広告除去の買い切りで運営し、プレイから基地開拓までの流れを計測して、公開後の改善につなげています。',
		rows: [
			['Ads', 'バナーは研究ラボのスクロール末尾に配置。全画面広告は、通常問題・アクションラボ・Infinity・複合アノマリーの完了回数を共有し、5回ごとに最大1回、記録保存後・結果表示前に出します。回答中には表示しません。'],
			['Purchase', '「広告を非表示」は期限も自動更新もない非消費型アイテムで、バナーと全画面広告を除去します。同じストアのアカウントで購入を復元でき、購入なしでもすべての問題を遊べます。Web版にはアプリ内決済を表示しません。'],
			['Analytics', 'モバイルのFirebase AnalyticsとWebのGA4で、トレーニング、復習、報酬、基地開拓、RTS遠征、広告・購入のイベントを定義。計測仕様とBigQueryの集計を合わせて管理し、遠征の完了・中断と未確定の記録も区別します。'],
			['Consent', '年齢確認と利用状況データの共有設定に応じて分析を開始します。共有は設定から停止でき、Webでも同じ確認を経てGA4を読み込みます。ランキングへの参加は、この分析同意とは別に選べます。'],
		],
	},
];

const stack = [
	['App / Game', 'Flutter、Material 3、GoRouter、Flame'],
	['State / Local', 'Provider、Flutter Bloc、SharedPreferences、JSON問題集・進行バックアップ'],
	['Online', 'Firebase匿名認証、Cloud Firestore（モバイル版ランキング）'],
	['Analytics', 'Firebase Analytics、Web GA4、BigQuery'],
	['Ads / Purchases', 'Google Mobile Ads、in_app_purchase、StoreKit、Google Play Billing'],
	['Quality', 'flutter_test、Mockito、レスポンシブ回帰テスト、実画面の自動撮影'],
	['Delivery', 'GitHub Actions、Fastlane、App Store Connect、Google Play Console'],
];
---

<Base
	title="無限脳"
	description="脳トレの積み重ねで7つのコロニーを開拓する「無限脳」のケーススタディ。Flutter・FlameによるRTS遠征、復習帳、モバイル版ランキングを備え、iOS・Android・Webへ公開。"
>
	<section class="shell pagehead">
		<p class="label"><b>Case study</b> — Product</p>
		<div class="feature" style="margin-top: 1.25rem">
			<div>
				<h1>無限脳</h1>
				<p class="lead">脳を鍛えて、宇宙の基地を育てる。</p>
				<p class="lead">
					数学・論理・記憶・注意・言語のクイズと操作パズル。その積み重ねが、7つのコロニーの建設・復旧と、リアルタイムの拠点奪還戦につながるトレーニングゲームです。
				</p>
				<p class="lead">
					Infinityと複合アノマリー、復習帳、相棒のマスコット、モバイル版ランキングも用意。一つのFlutterコードベースから、日本語・英語でiOS・Android・Webへ配信しています。
				</p>
				<ul class="tags" style="margin-top: 2rem">
					<li>Released</li><li>Flutter / Flame</li><li>iOS</li><li>Android</li><li>Web</li>
					<li>日本語 / English（Brain Infinity）</li>
				</ul>
				<div class="actions">
					<a class="btn" href="https://braininfinity.googja.dev/" rel="noopener">Web版を試す<span aria-hidden="true">↗</span></a>
					<a class="ulink" href="/works/">Worksへ戻る<span aria-hidden="true">→</span></a>
				</div>
			</div>
			<figure class="plate">
				<img src="/Icon-512.png" width="512" height="512" alt="無限脳のアプリアイコン" />
				<figcaption><span>無限脳</span><span>App icon</span></figcaption>
			</figure>
		</div>
	</section>

	<div class="band" id="screens">
		<div class="shell section">
			<p class="label" data-reveal><b>01</b> Screens</p>
			<div class="section__body" data-reveal style="--reveal-delay:.09s">
				<h2 class="h2">いまの無限脳を、12の画面で。</h2>
				<p class="lead" style="margin-top: 1.5rem">
					1.1.2のアプリ本体から、ストア用の撮影テストで書き出した日本語版の実画面です。進行や成績には撮影用データを使っています。
				</p>
				<p class="label" style="margin-top: 1rem">Screens updated — <time datetime="2026-10-07">2026.10.07</time></p>
				<ul class="screens">
					{shots.map((s) => (
						<li><figure>
							<img src={s.src} width={s.width} height={s.height} alt={s.alt} loading="lazy" decoding="async" />
							<figcaption><span>{s.no}</span>{s.caption}</figcaption>
						</figure></li>
					))}
				</ul>
			</div>
		</div>
	</div>

	<div class="band">
		<div class="shell section">
			<p class="label" data-reveal><b>02</b> Scope</p>
			<div class="section__body" data-reveal style="--reveal-delay:.09s">
				<h2 class="h2">企画から、ゲーム開発と公開後の運営まで。</h2>
				<p class="lead" style="margin-top: 1.5rem">
					問題データと出題ロジック、FlutterのUI、Flameの戦闘、進行の保存、Firebaseのランキング、分析と収益化、CI/CD、ストア公開を一貫して担当しています。
				</p>
				<ul class="notes" style="margin-top: 2.5rem">
					<li data-no="01"><span><b>学習とゲーム進行をつなぐ。</b>回答の報酬をコアの成長と基地開拓へ結び、結果から次の施設へ進める流れを設計しています。</span></li>
					<li data-no="02"><span><b>複数の端末と遊び方に対応する。</b>スマートフォン、タブレット、ブラウザの幅や向きに合わせて配置を切り替え、高コントラスト、文字拡大、動きの軽減、形状とラベル、効果音の字幕を用意しています。</span></li>
					<li data-no="03"><span><b>配信する素材も軽くする。</b>1.1.2では相棒とランキングの追加に加え、画像のWebP化でアプリ容量を約110MB削減しました。</span></li>
				</ul>
			</div>
		</div>
	</div>

	{sections.map((section) => (
		<div class="band">
			<div class="shell section">
				<p class="label" data-reveal><b>{section.no}</b> {section.label}</p>
				<div class="section__body" data-reveal style="--reveal-delay:.09s">
					<h2 class="h2">{section.title}</h2>
					<p class="lead" style="margin-top: 1.5rem">{section.lead}</p>
					<table class="table" style="margin-top: 2.5rem"><tbody>
						{section.rows.map(([label, text]) => <tr><th scope="row">{label}</th><td>{text}</td></tr>)}
					</tbody></table>
				</div>
			</div>
		</div>
	))}

	<div class="band">
		<div class="shell section">
			<p class="label" data-reveal><b>08</b> Stack &amp; Principles</p>
			<div class="section__body" data-reveal style="--reveal-delay:.09s">
				<h2 class="h2">一つの実装を、配信と運営まで育てる。</h2>
				<table class="table" style="margin-top: 2.5rem"><tbody>
					{stack.map(([label, text]) => <tr><th scope="row">{label}</th><td>{text}</td></tr>)}
				</tbody></table>
				<ul class="notes" style="margin-top: 2.5rem">
					<li data-no="01"><span><b>出題の判断をテストできる形にする。</b>10問の組み立ては問題集・成績・直近の履歴を受け取る処理に分け、乱数を固定して苦手なグループの優先や重複回避を検証します。</span></li>
					<li data-no="02"><span><b>進行とオンラインの状態を分ける。</b>ローカルの記録保存を先に完了し、ランキングは参加を選んだ新しいプレイだけを送信。進行のバックアップが、別のオンライン参加者の認証を上書きしない構成にしています。</span></li>
					<li data-no="03"><span><b>画面と掲載素材を同じ実装から出す。</b>アプリのウィジェットを、日本語・英語とストア指定の端末サイズで撮影。UIの変更を実画面で確認し、掲載画像もその撮影結果から更新します。</span></li>
				</ul>
			</div>
		</div>
	</div>

	<div class="band">
		<div class="shell section">
			<p class="label" data-reveal><b>09</b> Where to play</p>
			<div class="section__body" data-reveal style="--reveal-delay:.09s">
				<h2 class="h2">公開先</h2>
				<ul class="links" style="margin-top: 2.5rem">
					<li><a href="https://braininfinity.googja.dev/" rel="noopener"><b>Web ↗</b><span>ブラウザから脳トレと基地開拓をプレイできます。</span></a></li>
					<li><a href="https://apps.apple.com/jp/app/id6755319401" rel="noopener"><b>App Store ↗</b><span>iPhone・iPad版。ランキングにも参加できます。</span></a></li>
					<li><a href="https://play.google.com/store/apps/details?id=com.sangraal.androidfirst&hl=ja" rel="noopener"><b>Google Play ↗</b><span>Android版。ランキングにも参加できます。</span></a></li>
				</ul>
			</div>
		</div>
	</div>
</Base>
