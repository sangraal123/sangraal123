---
import Base from '../layouts/Base.astro';
import WorkList from '../components/WorkList.astro';
import { works, phases, shots, businessJsonLd } from '../data/site';
---

<Base
	bare
	title="sangraal — Independent Mobile Product Studio"
	description="脳トレゲーム「無限脳」をiOS・Androidで運営し、漢字パズル「漢字脳」を開発中のsangraal。AIを活用した企画・実装・ストア公開と、開発ガイド「VibeCode Mobile」を紹介します。"
>
	<script type="application/ld+json" slot="head" set:html={JSON.stringify(businessJsonLd)} />

	<section class="hero">
		<div class="shell hero__stage">
			<p class="label hero__eyebrow"><b>sangraal</b> — Independent Mobile Product Studio</p>
			<h1 class="hero__display">
				<span class="line"><span>企画から</span></span>
				<span class="line"><span>ストア公開まで、</span></span>
				<span class="line"><span><i>つくり切る。</i></span></span>
			</h1>
		</div>

		{/* 帯は流れたまま、中身を技術名から実物に入れ替える。
		    最初の画面のすぐ下で、作ったものが動いているところが横に流れていく。

		    継ぎ目を消す条件: 1組ぶん送ったあとも画面が埋まっていること＝(組数-1)×1組の幅 ≥ 画面幅。
		    12枚の1組を4組並べ、広い画面でも継ぎ目が空かないようにする。
		    繰り返し分の画像はブラウザのキャッシュから出る。
		    2組目以降は読み上げ対象から外す。 */}
		<div class="proof">
			<div class="shell proof__head">
				<p class="label"><b>無限脳</b> — 実際の画面</p>
				<a class="ulink" href="/works/brain-infinity/"
					>ケーススタディへ<span aria-hidden="true">→</span></a
				>
			</div>
			<div class="proof__rail">
				<div class="proof__track">
					{
						Array.from({ length: 4 }, (_, group) => (
							<ul class="proof__group" aria-hidden={group > 0 ? 'true' : undefined}>
								{shots.map((s) => (
									<li>
										<figure>
											<img
												src={s.src}
												width={s.width}
												height={s.height}
												alt={group > 0 ? '' : s.alt}
												{/* 横に流れる帯なので lazy は効かない（画面外の分が読み込まれず
												    流れてきた瞬間に空く）。繰り返し分はキャッシュから出る。 */}
												loading="eager"
												decoding="async"
											/>
											<figcaption>
												<span>{s.no}</span>
												{s.caption}
											</figcaption>
										</figure>
									</li>
								))}
							</ul>
						))
					}
				</div>
			</div>
		</div>

		<div class="shell hero__grid">
			<div>
				<p class="lead">
					FlutterとExpoを軸に、UI実装、Firebase連携、CI/CD、ストア審査、公開後の改善までを一つの工程として扱います。
				</p>
				<p class="lead">
					AIエージェントは判断を任せる相手ではなく、調査・仕様化・実装・レビューで役割を分ける道具として使っています。
				</p>
				<div class="actions">
					<a class="btn" href="/works/">Works を見る<span aria-hidden="true">→</span></a>
					<a class="ulink" href="/vibecode-mobile/"
						>VibeCode Mobile を読む<span aria-hidden="true">→</span></a
					>
				</div>
			</div>

			<dl class="spec">
				<dt>Focus</dt>
				<dd>Mobile Products</dd>
				<dt>Build</dt>
				<dd>Flutter / Expo / React Native</dd>
				<dt>Backend</dt>
				<dd>Firebase / Google Cloud</dd>
				<dt>Ship</dt>
				<dd>App Store / Google Play / Web</dd>
				<dt>Writing</dt>
				<dd><a href="/vibecode-mobile/">VibeCode Mobile</a></dd>
				<dt>Code</dt>
				<dd><a href="https://github.com/sangraal123" rel="me noopener">github.com/sangraal123</a></dd>
				<dt>Company</dt>
				<dd><a href="/about/#company">運営者情報</a></dd>
			</dl>
		</div>
	</section>

	<div class="band" id="featured">
		<div class="shell section">
			<p class="label" data-reveal><b>01</b> Featured</p>
			<div class="section__body feature" data-reveal style="--reveal-delay:.09s">
				<div>
					<p class="status">Released — 1.1.2 / iOS / Android</p>
					<h2 class="feature__name">無限脳</h2>
					<p class="lead">
						数学、論理、記憶、注意、言語の5領域を鍛え、その積み重ねで宇宙の基地を育てる脳トレゲーム。クイズと操作パズルから、7つのコロニーの開拓とリアルタイムの拠点奪還戦へつながります。
					</p>
					<p class="lead">
						1.1.2では、Infinityと複合アノマリーのランキングと、ホーム・結果画面に浮遊する相棒を追加しました。画像の軽量化でアプリ容量も約110MB削減。企画からFlutter・Flameでのゲーム開発、Firebase連携、分析、広告と課金、ストア運営まで担当しています。
					</p>
					<ul class="figures">
						<li><b>5</b><span>Categories</span></li>
						<li><b>2</b><span>Languages</span></li>
						<li><b>2</b><span>Platforms</span></li>
						<li><b>1</b><span>Codebase</span></li>
					</ul>
					<div class="actions">
						<a class="ulink" href="/works/brain-infinity/"
							>ケーススタディを読む<span aria-hidden="true">→</span></a
						>
						<a class="ulink" href="https://braininfinity.googja.dev/" rel="noopener"
							>アプリ紹介サイト<span aria-hidden="true">↗</span></a
						>
					</div>
				</div>

				<figure class="plate">
					<img
						src="/Icon-512.png"
						width="512"
						height="512"
						alt="無限脳のアプリアイコン"
						loading="lazy"
					/>
					<figcaption><span>無限脳</span><span>Flutter</span></figcaption>
				</figure>
			</div>
		</div>
	</div>

	<div class="band" id="kanjinou">
		<div class="shell section">
			<p class="label" data-reveal><b>—</b> In development</p>
			<div class="section__body feature" data-reveal style="--reveal-delay:.09s">
				<div>
					<p class="status">開発中・公開準備中 — iOS / Android</p>
					<h2 class="feature__name">漢字脳</h2>
					<p class="lead">思い出すって、ちょっと、うれしい。</p>
					<p class="lead">
						4つの二字熟語をつなぐ「和同開珎」、読み・意味・用例に出会う「四字熟語」、覚えた言葉を選ぶ「手がかり想起」。3つの遊びを1日3問から楽しむ、大人の漢字パズルをExpoで開発しています。
					</p>
					<p class="lead">
						本日の脳活、語彙帳、プレイカレンダーを用意。iPhone・iPad・Android向けの公開を準備しており、紹介サイトでは和同開珎をお試しいただけます。
					</p>
					<div class="actions">
						<a class="ulink" href="https://kanjinou.googja.dev/" rel="noopener">漢字脳の紹介・お試しへ<span aria-hidden="true">↗</span></a>
					</div>
				</div>
				<figure class="plate">
					<img src="/works/kanjinou/app-icon.png" width="512" height="512" alt="漢字脳のアプリアイコン" loading="lazy" />
					<figcaption><span>漢字脳</span><span>Expo</span></figcaption>
				</figure>
			</div>
		</div>
	</div>

	<div class="band" id="work">
		<div class="shell section">
			<p class="label" data-reveal><b>02</b> Selected work</p>
			<div class="section__body" data-reveal style="--reveal-delay:.09s">
				<h2 class="h2">プロダクト、ガイド、共同開発。</h2>
				<div style="margin-top: clamp(2rem, 4vw, 3rem)">
					<WorkList items={works} />
				</div>
				<div class="actions">
					<a class="ulink" href="/works/">担当範囲つきの一覧を見る<span aria-hidden="true">→</span></a>
				</div>
			</div>
		</div>
	</div>

	<div class="band" id="about">
		<div class="shell section">
			<p class="label" data-reveal><b>03</b> About</p>
			<div class="section__body" data-reveal style="--reveal-delay:.09s">
				<h2 class="h2">コードだけでなく、<br />プロダクトの一生を扱う。</h2>
				<p class="lead" style="margin-top: 1.75rem">
					無限脳はFlutter・Flame、開発中の漢字脳はExpoで実装し、プロダクトに合わせて技術を選んでいます。
				</p>
				<p class="lead">
					画面を実装して終わりにせず、Firebaseによるバックエンドと分析基盤、ストアへの提出、公開後の数字の確認と改善までを続けます。
				</p>
				<p class="lead">
					新しいアイデアを素早く動かすプロトタイピングと、公開できる品質へ持っていくビルドの、両方を仕事にしています。
				</p>
				<div class="actions">
					<a class="ulink" href="/about/">About を読む<span aria-hidden="true">→</span></a>
				</div>
			</div>
		</div>
	</div>

	<div class="band band--sunk" id="guide">
		<div class="shell section">
			<p class="label" data-reveal><b>04</b> VibeCode Mobile</p>
			<div class="section__body" data-reveal style="--reveal-delay:.09s">
				<h2 class="h2">作り方も、公開しています。</h2>
				<p class="lead" style="margin-top: 1.75rem">
					AIに指示しながらExpoアプリを企画・実装・公開・収益化する工程を、7つのフェーズに分けた実践ドキュメントにまとめています。
				</p>
				<p class="lead">
					プロンプト、仕様書テンプレート、実装チュートリアル、公開前チェックリストまで。
				</p>
				<ul class="phases">
					{
						phases.map((p) => (
							<li>
								<a href={p.href}>
									<span>{p.no}</span>
									<span class="phases__label">
										{p.label}
										{p.wip && <em>執筆中</em>}
									</span>
								</a>
							</li>
						))
					}
				</ul>
				<div class="actions">
					<a class="btn" href="/vibecode-mobile/">学習ロードマップへ<span aria-hidden="true">→</span></a>
				</div>
			</div>
		</div>
	</div>
</Base>
