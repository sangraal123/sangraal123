---
const path = Astro.url.pathname;
const isCurrent = (href: string) => (path === href || path.startsWith(href) ? 'page' : undefined);
---

<header class="masthead">
	<div class="shell masthead__inner">
		<a class="brand" href="/">sangraal<em>googja.dev</em></a>
		<nav aria-label="サイト">
			<a href="/works/" aria-current={isCurrent('/works/')}>Works</a>
			<a href="/about/" aria-current={isCurrent('/about/')}>About</a>
			<a href="/vibecode-mobile/" aria-current={isCurrent('/vibecode-mobile/')}>
				<span class="on-wide">VibeCode Mobile</span><span class="on-narrow">Guide</span>
			</a>
			<a class="is-long" href="https://github.com/sangraal123" rel="me noopener">GitHub</a>
			<button class="theme-toggle" type="button" data-theme-toggle aria-label="表示テーマを切り替える">
				<svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
				</svg>
				<svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="12" cy="12" r="4" />
					<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
				</svg>
			</button>
		</nav>
	</div>
</header>

<script>
	// Starlight と同じキーに書き戻すので、ガイド側のセレクタとも同期する。
	const root = document.documentElement;
	document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
		const next = root.dataset.theme === 'light' ? 'dark' : 'light';
		root.dataset.theme = next;
		try {
			localStorage.setItem('starlight-theme', next);
		} catch {
			/* localStorage が使えない環境ではその場の切り替えだけ */
		}
	});
</script>
