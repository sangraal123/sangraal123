---
import PageTitle from '@astrojs/starlight/components/PageTitle.astro';

const { lesson } = Astro.locals.starlightRoute.entry.data;
---

<PageTitle />
{lesson && (
	<aside class="lesson-guide" aria-label="この記事の進め方" data-pagefind-ignore>
		<dl>
			<div><dt>前提</dt><dd>{lesson.prerequisite}</dd></div>
			<div><dt>今回作るもの</dt><dd>{lesson.output}</dd></div>
			<div><dt>完了条件</dt><dd>{lesson.completion}</dd></div>
		</dl>
		<details>
			<summary>実行環境・時間・費用の目安</summary>
			<dl>
				<div><dt>実行環境</dt><dd>{lesson.environment}</dd></div>
				<div><dt>学習時間</dt><dd>{lesson.effort}（個人差あり。ビルド・審査の待ち時間は除く）</dd></div>
				<div><dt>費用</dt><dd>{lesson.cost}</dd></div>
			</dl>
		</details>
		<p><a href="/vibecode-mobile/learning-paths/">学習コース</a><span aria-hidden="true"> · </span><a href="/vibecode-mobile/status/">教材の更新・検証範囲</a></p>
	</aside>
)}

<style>
	.lesson-guide { margin-block-start: 1.5rem; padding: 1rem 1.25rem; border: 1px solid var(--sl-color-gray-5); border-inline-start: 3px solid var(--sl-color-accent); border-radius: .25rem; font-size: .9rem; color: var(--sl-color-gray-2); }
	dl { margin: 0; }
	dl > div { display: grid; grid-template-columns: 7em minmax(0, 1fr); gap: .75rem; padding-block: .3rem; }
	dt { font-weight: 600; color: var(--sl-color-white); }
	dd { margin: 0; overflow-wrap: anywhere; }
	details { margin-block-start: .65rem; }
	summary { cursor: pointer; color: var(--sl-color-white); }
	details dl { margin-block-start: .5rem; }
	p { margin-block: .75rem 0; }
	a { color: var(--sl-color-text-accent); text-underline-offset: .2em; }
	@media (max-width: 30rem) { dl > div { grid-template-columns: 1fr; gap: .15rem; padding-block: .4rem; } }
</style>
